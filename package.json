{
  "name": "balcao-farmaceutico",
  "version": "1.0.0",
  "private": true,
  "description": "Balcão Farmacêutico: consulta de medicamentos para drogarias (Android e iOS via Capacitor)",
  "scripts": {
    "icons": "capacitor-assets generate --iconBackgroundColor '#0A6B5C' --splashBackgroundColor '#ECEFEE' --splashBackgroundColorDark '#0E1312'",
    "sync": "cap sync",
    "android": "cap open android",
    "ios": "cap open ios",
    "apk": "cap sync android && cd android && ./gradlew assembleDebug"
  },
  "dependencies": {
    "@capacitor/android": "8.6.0",
    "@capacitor/core": "8.6.0",
    "@capacitor/ios": "8.6.0"
  },
  "devDependencies": {
    "@capacitor/assets": "4.0.0",
    "@capacitor/cli": "8.6.0"
  }
}
